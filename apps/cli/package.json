{
  "name": "@hourkeep/cli",
  "version": "0.0.0",
  "private": true,
  "description": "hourkeep: unprivileged command-line client",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hourkeep/core": "workspace:*",
    "@hourkeep/ipc": "workspace:*",
    "commander": "15.0.0"
  },
  "bin": {
    "hourkeep": "./dist/main.js"
  },
  "devDependencies": {
    "@hourkeep/daemon": "workspace:*"
  }
}
